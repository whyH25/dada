<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.mvc.dao.InterviewRoomPersonaDao">

    <insert id="insertRoomPersonas" parameterType="java.util.List">
        INSERT INTO interview_room_persona (room_id, persona_role, persona_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roomId}, #{item.personaRole}, #{item.personaId})
        </foreach>
    </insert>

    <!-- 회원탈퇴 시 해당 유저의 면접방에 속한 페르소나 매핑을 일괄 비활성화 -->
    <update id="deactivateByRoomIds">
        UPDATE interview_room_persona SET deleted_at = NOW()
        WHERE room_id IN
        <foreach collection="roomIds" item="roomId" open="(" separator="," close=")">
            #{roomId}
        </foreach>
    </update>

</mapper>
