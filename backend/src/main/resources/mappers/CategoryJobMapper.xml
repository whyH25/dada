<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.mvc.dao.CategoryDao">

    <resultMap id="GroupWithJobsMap" type="com.ssafy.mvc.dto.CategoryJobGroupDto">
        <id     property="groupId"   column="group_id"/>
        <result property="groupCode" column="group_code"/>
        <result property="groupName" column="group_name"/>
        <result property="sortOrder" column="sort_order"/>
        <collection property="jobs" ofType="com.ssafy.mvc.dto.JobCategoryDto">
            <id     property="jobId"    column="job_id"/>
            <result property="jobCode"  column="job_code"/>
            <result property="jobName"  column="job_name"/>
            <result property="sortOrder" column="job_sort_order"/>
        </collection>
    </resultMap>

    <select id="selectAllGroupsWithJobs" resultMap="GroupWithJobsMap">
        SELECT
            g.group_id,
            g.group_code,
            g.group_name,
            g.sort_order,
            j.job_id,
            j.job_code,
            j.job_name,
            j.sort_order AS job_sort_order
        FROM category_job_group g
        LEFT JOIN category_job j ON j.group_id = g.group_id
        ORDER BY g.sort_order, g.group_id, j.sort_order, j.job_id
    </select>

</mapper>
