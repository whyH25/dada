<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.mvc.dao.AdminDao">

    <select id="selectByEmail" parameterType="string" resultType="com.ssafy.mvc.dto.AdminDto">
        SELECT
            admin_id,
            admin_email,
            admin_pwd,
            admin_name,
            created_at
        FROM admins
        WHERE admin_email = #{adminEmail}
    </select>

</mapper>
